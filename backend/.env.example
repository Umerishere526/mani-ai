# Copy to backend/.env and fill in. The real .env is gitignored.

ENVIRONMENT=development

# Postgres, addressed directly so a chat turn can hold its writes in one
# transaction. For local Supabase, `supabase status` prints the DB URL.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54342/postgres

# Supabase hosts Auth (JWTs we verify) and Storage (exercise audio).
# Use the machine's LAN IP, not loopback: storage signed URLs are built from
# this value and handed to a phone, which cannot reach your loopback address.
SUPABASE_URL=http://127.0.0.1:54341
SUPABASE_SERVICE_ROLE_KEY=

# Set whichever the project signs with. Legacy projects use the shared secret;
# newer ones publish a key set, in which case leave the secret blank and the
# JWKS URL is derived from SUPABASE_URL unless overridden here.
SUPABASE_JWT_SECRET=
SUPABASE_JWKS_URL=

# OpenRouter is the only model provider. Required for chat.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_DATA_COLLECTION=deny
LLM_TIMEOUT_SECONDS=60

# Pins the upstream provider and refuses fallbacks. Without this OpenRouter may route a
# conversation to any provider serving the model, under that provider's terms.
OPENROUTER_PROVIDER_ORDER=["google-ai-studio"]
OPENROUTER_ALLOW_FALLBACKS=false

# Used only when a prompt row names no model of its own.
DEFAULT_CHAT_MODEL=google/gemini-3-flash-preview
DEFAULT_SUMMARY_MODEL=openai/gpt-oss-120b

# Origins allowed to call this from a browser. web/ cannot reach the API until its
# origin is listed here; native mobile is not subject to CORS.
CORS_ORIGINS=["http://localhost:3000"]

LOG_LEVEL=INFO

# Error tracking. Leave blank to disable.
SENTRY_DSN=

# Includes technique reasoning in responses, for conversation testing.
AI_DEBUG_MODE=false

# When false the crisis panel still appears but the user can keep chatting.
CRISIS_BLOCKS_CHAT=true

# Overrides the per-environment default (1s in development, 300s otherwise).
PROMPT_CACHE_TTL_SECONDS=
