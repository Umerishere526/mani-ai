# Copy to chat-tester/.env and fill in. Points at the same local Supabase and the same
# running backend - this tool is a client of the API, not a second copy of it.

API_BASE_URL=http://127.0.0.1:8000

# For signing in through local Supabase Auth, as a real app does, and for the read-only
# debug panels. `supabase status -o env` prints all of these: API_URL, ANON_KEY,
# SERVICE_ROLE_KEY, DB_URL. None of them is a secret for local Supabase.
SUPABASE_URL=http://127.0.0.1:54341
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54342/postgres
