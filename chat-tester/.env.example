# Copy to chat-tester/.env and fill in. Points at the same local Supabase and the same
# running backend - this tool is a client of the API, not a second copy of it.

API_BASE_URL=http://127.0.0.1:8000

# Only for minting a test JWT and creating the auth.users row it needs - the same two
# things a real sign-in would give you. Read from `supabase status` locally; these are
# the same values backend/.env already has.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54342/postgres
SUPABASE_JWT_SECRET=
