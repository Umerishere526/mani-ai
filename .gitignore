# Per-app .gitignore files in web/ and mobile/ still apply. This file
# covers backend/ (which has none) and noise that spans the whole repo.

# Python
backend/.venv/
chat-tester/.venv/
__pycache__/
*.py[cod]
.pytest_cache/
backend/.eval/

# Environment
.env
.env.*
!.env.example

# Editors
.vscode/
.idea/

# Claude Code reads project settings only from the session's working directory,
# so a .claude/ in an app subdirectory is never loaded. Keep settings at the root.
*/.claude/

# macOS
.DS_Store

# Exercise audio is client content and stays off GitHub; production's own bucket holds it, and scripts/seed_exercises.py
# reads local copies from here.
backend/content/exercises/*.mp3

# Saved live runs of scripts/scenario_check.py: transcripts of test conversations, compared locally and never committed.
backend/.scenario-runs/

# The evaluation and suite write their runs here; the files hold model replies, not code.
backend/evals/results/
